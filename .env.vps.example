# Copiar como .env.vps y reemplazar todos los valores CHANGE_ME.
POSTGRES_DB=mining_ai
POSTGRES_USER=mining
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
DATABASE_URL=postgresql://mining:CHANGE_ME_DATABASE_PASSWORD@db:5432/mining_ai

SECRET_KEY=CHANGE_ME_LONG_RANDOM_SECRET
SESSION_COOKIE_SECURE=0
APP_PORT=5050
PORT=5050

PREDICTIVE_CAPTURE_INTERVAL=900
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=60
